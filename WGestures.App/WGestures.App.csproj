<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>WinExe</OutputType>
    <AssemblyName>WGestures</AssemblyName>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <PublishUrl>publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>2</ApplicationRevision>
    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
    <UseApplicationTrust>false</UseApplicationTrust>
      
    <PublishWizardCompleted>true</PublishWizardCompleted>
    <BootstrapperEnabled>true</BootstrapperEnabled>
   <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
   <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
   <NoWarn>$(NoWarn);SYSLIB0011</NoWarn>
      <UseWindowsForms>true</UseWindowsForms>
      <UseWpf>true</UseWpf>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyOriginatorKeyFile>
    </AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <BuildDir>Build</BuildDir>
  </PropertyGroup>
  <PropertyGroup>
    <TargetZone>LocalIntranet</TargetZone>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="Gui\CommandViews\CmdCommandView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Gui\CommandViews\ScriptCommandView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Gui\CommandViews\SendTextCommandView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Gui\CommandViews\TaskSwitcherCommandView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Gui\CommandViews\WebSearchCommandView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Gui\CommandViews\WindowControlCommandView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Gui\Controls\ReorderableListView\EventsListBox.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Gui\Controls\ReorderableListView\ReorderableListView.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Gui\Controls\ShortcutRecordButton.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Gui\CommandViews\GeneralNoParameterCommandView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Gui\CommandViews\GotoUrlCommandView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Gui\CommandViews\HotKeyCommandView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Gui\CommandViews\OpenFileCommandView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Gui\CommandViews\CommandViewUserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Gui\Controls\AlwaysSelectedListView.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Gui\Controls\ColorButton.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Gui\Controls\LazyPaintButton.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Gui\Controls\InstantNumericUpDown.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Gui\Controls\LineFlowLayout.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Gui\Controls\LineLabel.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Gui\Controls\MacGroupBox.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Gui\Controls\MetroButton.cs">
      <SubType>Component</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*.*" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="defaults\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="externalResource\**\*.*" />
    <Content Include="QuickStartGuide\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    
    <Content Include="UpdateLog.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <None Include="AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>

    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="Lnk" Version="2026.5.3" />
    <PackageReference Include="NLua" Version="1.7.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Vanara.PInvoke.Gdi32" Version="5.0.5" />
    <PackageReference Include="Vanara.PInvoke.User32" Version="5.0.5" />
    <PackageReference Include="WindowsInput" Version="6.4.1" />
    <PackageReference Include="WindowsShortcutFactory" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="Views\ErrorWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\SearchBox.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
  <PropertyGroup />
</Project>